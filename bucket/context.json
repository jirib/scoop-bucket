{
    "version": "2026.08.23",
    "description": "ConTeXt LMTX typesetting system based on LuaMetaTeX",
    "homepage": "https://www.contextgarden.net/",
    "license": "GPL-2.0-only",
    "notes": [
        "ConTeXt LMTX is a rolling release: the first install downloads the full",
        "ConTeXt tree (a few hundred MB) and generates formats, so it can take a while.",
        "Run 'scoop update context' to pick up newer builds when the upstream date changes."
    ],
    "architecture": {
        "64bit": {
            "url": "https://lmtx.pragma-ade.com/install-lmtx/context-win64.zip",
            "hash": "sha256:efbd08587cde56014c469eb7be93a3332ac4fdc5f18523a0be542def74473dbc"
        }
    },
    "pre_install": [
        "$bin_dir = Join-Path $dir 'tex\\texmf-win64\\bin'",
        "if (-not (Test-Path $bin_dir)) { New-Item $bin_dir -ItemType Directory -Force | Out-Null }",
        "if (-not (Test-Path (Join-Path $bin_dir 'mtxrun.exe'))) { New-Item (Join-Path $bin_dir 'mtxrun.exe') -ItemType File -Force | Out-Null }",
        "if (-not (Test-Path (Join-Path $bin_dir 'context.exe'))) { New-Item (Join-Path $bin_dir 'context.exe') -ItemType File -Force | Out-Null }"
    ],
    "bin": [
        ["tex\\texmf-win64\\bin\\mtxrun.exe", "mtxrun"],
        ["tex\\texmf-win64\\bin\\context.exe", "context"]
    ],
    "env_add_path": "tex\\texmf-win64\\bin",
    "persist": [
        "tex"
    ],
    "post_install": [
        "Push-Location $dir",
        "$server = 'lmtx.pragma-ade.com,lmtx.pragma-ade.nl,lmtx.contextgarden.net'",
        "$contextcnf = Join-Path $dir 'tex\\texmf-context\\web2c\\contextcnf.lua'",
        "& \"$dir\\bin\\mtxrun.exe\" --script \"$dir\\bin\\mtx-install.lua\" --update --server=$server --instance=install-lmtx --extras=\"\" --platform=win64",
        "$bootstrap_exit = $LASTEXITCODE",
        "if (-not (Test-Path $contextcnf)) {",
        "    Write-Host 'contextcnf.lua missing after first bootstrap pass.'",
        "    Write-Host 'Working around a known mtx-install.lua bug: its zip fast-path (util-zip.lua unzipdir) treats zip directory-marker entries as content (unzipfile returns \"\" for them, which is truthy in Lua) and writes them as 0-byte files, e.g. tex\\texmf-context\\web2c, which then blocks mkdir for the real files that belong inside.'",
        "    Write-Host 'mtx-install.lua always saves tex\\texmf.tma / tex\\texmf-context.tma after the pass regardless of write success, so a second run takes the per-file diff/update path instead of the buggy zip fast-path, once the 0-byte blockers are removed.'",
        "    $texRoot = Join-Path $dir 'tex'",
        "    foreach ($treeName in @('texmf', 'texmf-context')) {",
        "        $tree = Join-Path $texRoot $treeName",
        "        if (Test-Path $tree) {",
        "            Get-ChildItem -Path $tree -Recurse -File -ErrorAction SilentlyContinue | Where-Object { $_.Length -eq 0 } | Remove-Item -Force -ErrorAction SilentlyContinue",
        "        }",
        "    }",
        "    & \"$dir\\bin\\mtxrun.exe\" --script \"$dir\\bin\\mtx-install.lua\" --update --server=$server --instance=install-lmtx --extras=\"\" --platform=win64",
        "    $bootstrap_exit = $LASTEXITCODE",
        "}",
        "Pop-Location",
        "$context_exe = Join-Path $dir 'tex\\texmf-win64\\bin\\context.exe'",
        "$mtxrun_exe = Join-Path $dir 'tex\\texmf-win64\\bin\\mtxrun.exe'",
        "$context_ok = (Test-Path $context_exe) -and (Get-Item $context_exe).Length -gt 0",
        "$mtxrun_ok = (Test-Path $mtxrun_exe) -and (Get-Item $mtxrun_exe).Length -gt 0",
        "$contextcnf_ok = Test-Path $contextcnf",
        "Write-Host '--- diagnostics: tex tree after bootstrap ---'",
        "$texPath = Join-Path $dir 'tex'",
        "if (Test-Path $texPath) { Get-ChildItem $texPath | Format-Table Name, Mode | Out-String | Write-Host } else { Write-Host 'tex\\ does not exist' }",
        "$ctxTree = Join-Path $texPath 'texmf-context'",
        "if (Test-Path $ctxTree) {",
        "    $count = (Get-ChildItem $ctxTree -Recurse -File -ErrorAction SilentlyContinue | Measure-Object).Count",
        "    Write-Host \"tex\\texmf-context contains $count files (recursive)\"",
        "} else {",
        "    Write-Host 'tex\\texmf-context does not exist'",
        "}",
        "Write-Host '--- end diagnostics ---'",
        "if ($bootstrap_exit -ne 0 -or -not $context_ok -or -not $mtxrun_ok -or -not $contextcnf_ok) {",
        "    throw \"ConTeXt LMTX bootstrap failed (exit code $bootstrap_exit): context.exe/mtxrun.exe missing/empty, or tex\\texmf-context tree not installed (contextcnf.lua missing) even after retry. Try 'scoop uninstall context' then 'scoop install context' again.\"",
        "}"
    ],
    "checkver": {
        "url": "https://lmtx.pragma-ade.com/install-lmtx/tex/status.tma",
        "regex": "\\[\"date\"\\]\\s*=\\s*\"(\\d{4})-(\\d{2})-(\\d{2})\"",
        "replace": "$1.$2.$3"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://lmtx.pragma-ade.com/install-lmtx/context-win64.zip"
            }
        }
    }
}
